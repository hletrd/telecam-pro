<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Shell-accessible deterministic screenshot surface. DUMP is signature-only, so ordinary
             third-party apps cannot launch this exported debug component. It is absent from release. -->
        <activity
            android:name="me.hletrd.telecampro.ui.UiSnapshotActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.TeleCamPro"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Shell-only camera measurement ingress. MainActivity intentionally ignores command
             extras; this signature-protected debug component is their sole exported producer. -->
        <activity
            android:name="me.hletrd.telecampro.DebugCameraControlActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>
