<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Visual-media READ access (user decision 2026-08-01): after a REINSTALL, MediaStore clears
         the previous install's row ownership, and a permission-less app cannot see those rows on a
         spec provider — the in-app gallery restore came back empty even though the files were
         intact. Requested CONTEXTUALLY (first gallery tap with nothing to review), never at
         launch; declining keeps the old own-rows-only behavior. USER_SELECTED joins so Android
         14+'s partial "Select photos" grant is handled first-class instead of read as a denial. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- The entire privacy story (PRIVACY.md, Play Data Safety) rests on the MERGED manifest having
         no network permission. tools:node="remove" makes that build-enforced instead of true-by-
         omission: a dependency AAR whose manifest sneaks INTERNET in would be stripped, not merged. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".TeleCameraApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeleCamPro">

        <!-- CameraUnit is NOT integrated: the com.oplus.ocs SDK dependency, the OPPO
             OpenCapability maven repo, and the debug-only availability probe were all removed
             2026-07-25 (see "Authenticated CameraUnit path" in docs/BACKLOG.md). Pasting an
             AUTH_CODE here alone does NOTHING — the SDK dependency must be restored first, and
             BACKLOG carries the full re-enable order. Once it is back, and after registering
             me.hletrd.telecampro (the applicationId — NOT the Kotlin namespace) + our signing
             cert on OPPO's CameraUnit developer portal, the issued AUTH_CODE goes here:
             <meta-data android:name="com.coloros.ocs.camera.AUTH_CODE" android:value="…" />
             None of this affects the shipped TC path: vendor session type 0x80b4 and the plain
             com.oplus.* Camera2 request keys need no AUTH_CODE and no SDK. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout|density"
            android:theme="@style/Theme.TeleCamPro"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">

            <!-- Android 16 (API 36) IGNORES screenOrientation/aspect/resizability on any display
                 whose smaller side is >= 600dp, so a tablet or unfolded foldable hands this
                 portrait-designed viewfinder a landscape window (device-reproduced on a Lenovo
                 TB336ZU / Android 16 / 1600x2560, 2026-08-02). This documented property restores the
                 previous behaviour for now; it is TEMPORARY by Android's own schedule — the opt-out
                 is removed at API 37, so the durable answer is the layout itself, which is why the
                 preview box was fixed to letterbox correctly in ANY window shape rather than relying
                 on this flag. Re-evaluate before raising targetSdk to 37. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
