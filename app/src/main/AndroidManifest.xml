<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Visual-media READ access (user decision 2026-08-01): after a REINSTALL, MediaStore clears
         the previous install's row ownership, and a permission-less app cannot see those rows on a
         spec provider — the in-app gallery restore came back empty even though the files were
         intact. Requested CONTEXTUALLY (first gallery tap with nothing to review), never at
         launch; declining keeps the old own-rows-only behavior. USER_SELECTED joins so Android
         14+'s partial "Select photos" grant is handled first-class instead of read as a denial. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- The entire privacy story (PRIVACY.md, Play Data Safety) rests on the MERGED manifest having
         no network permission. tools:node="remove" makes that build-enforced instead of true-by-
         omission: a dependency AAR whose manifest sneaks INTERNET in would be stripped, not merged. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".TeleCameraApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeleCamPro">

        <!-- CameraUnit is NOT integrated: the com.oplus.ocs SDK dependency, the OPPO
             OpenCapability maven repo, and the debug-only availability probe were all removed
             2026-07-25 (see "Authenticated CameraUnit path" in docs/BACKLOG.md). Pasting an
             AUTH_CODE here alone does NOTHING — the SDK dependency must be restored first, and
             BACKLOG carries the full re-enable order. Once it is back, and after registering
             me.hletrd.telecampro (the applicationId — NOT the Kotlin namespace) + our signing
             cert on OPPO's CameraUnit developer portal, the issued AUTH_CODE goes here:
             <meta-data android:name="com.coloros.ocs.camera.AUTH_CODE" android:value="…" />
             None of this affects the shipped TC path: vendor session type 0x80b4 and the plain
             com.oplus.* Camera2 request keys need no AUTH_CODE and no SDK. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout|density"
            android:theme="@style/Theme.TeleCamPro"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">

            <!-- screenOrientation stays: it is still honoured on PHONES (smaller side < 600dp), and
                 the whole app — glyph counter-rotation, capture masks, encoder framing — is built
                 around a device-fixed portrait layout there. PMA110 behaviour is unchanged.

                 What is GONE (2026-08-04) is PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY, which
                 used to force the restriction back on at sw600dp+. Android 16 ignores
                 screenOrientation on those displays and API 37 removes the opt-out outright, so the
                 durable answer was always the layout. It now exists: a wide window gets the operator
                 RAIL (CameraScreen's landscapeOperator), the preview takes the window-rotated aspect,
                 and preview rotation / tap mapping / glyph rotation each carry the window term
                 (RotationMath). Device-verified on the Lenovo TB336ZU (Android 16, 1600x2560) — the
                 same device that reproduced the original problem on 2026-08-02.

                 Deliberately NOT window-dependent: capture masks and encoder framing still derive
                 from GRAVITY, so a still or clip records the same field however the window is
                 turned. Do not "fix" those to follow window shape — see RotationMath. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
