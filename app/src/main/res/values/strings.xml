    <string name="microphone_permission_title">Microphone access</string>
    <!--
      The two uses and the three negatives are load-bearing (Play data-safety parity), so they are
      preserved exactly. Only the grammar changed: the old "and, before recording, while the input
      level meter is visible" left its subordinate clause with no verb to attach to.
    -->
    <string name="microphone_permission_rationale">TeleCam Pro uses the microphone to record audio with video, and to show the input level meter while Video mode is armed. Audio stays on this device. It is never uploaded, collected by the developer, or shared with third parties.</string>
