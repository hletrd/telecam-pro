# Release signing for Google Play. Copy this file to `keystore.properties` (which is gitignored) and
# fill in your upload-key details. The real file and any *.jks/*.keystore are never committed.
#
# Generate an upload keystore first (run from the repo root):
#
#   keytool -genkeypair -v \
#     -keystore telecampro-upload.jks \
#     -alias telecampro \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# keytool prompts for the store/key password and your name/org (self-signed is fine — Google's Play
# App Signing holds the real app-signing key; this is only your *upload* key).
#
# `storeFile` is REQUIRED here and must be one normalized, repository-relative regular file. The
# immutable release wrapper descriptor-copies and seals that exact file; there is deliberately no
# TELECAMPRO_STORE_FILE environment override. `keyPassword` defaults to `storePassword` when omitted.
# Prefer passing secret VALUES through environment variables instead of storing them here:
#
#   export TELECAMPRO_KEY_ALIAS=...
#   export TELECAMPRO_STORE_PASSWORD=...
#   export TELECAMPRO_KEY_PASSWORD=...

storeFile=telecampro-upload.jks
keyAlias=telecampro
# storePassword=CHANGE_ME
# keyPassword=CHANGE_ME
